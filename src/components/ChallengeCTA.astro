---
import Button from "./Button.astro";
import { getHome, img } from "../lib/cms";
const home = await getHome();
const d = home!.challengeCta;
---

<section class="cta" id="challenge" aria-labelledby="cta-title">
  <div class="cta__media img-zoom">
    <img
      src={img(d.image)}
      alt="Jenessa Wait sitting on the front steps of a house"
      width="703"
      height="812"
      loading="lazy"
    />
  </div>
  <div class="cta__panel">
    <div class="cta__content">
      <p class="section-label cta__eyebrow">{d.eyebrow}</p>
      <h2 id="cta-title" class="cta__title">
        <span class="cta__title-accent">{d.titleAccent}</span> {d.titleRest}
      </h2>
      <p class="cta__lead">{d.lead}</p>
      <p class="cta__body">{d.body1}</p>
      <p class="cta__body cta__body--breaks">{d.body2}</p>

      <Button href={d.ctaHref} label={d.ctaLabel} variant="light" class="cta__cta" />
    </div>
  </div>
</section>

<style>
  .cta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    background-color: var(--color-blue);
  }
  .cta__media {
    min-height: 100%;
  }
  .cta__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cta__panel {
    display: flex;
    align-items: center;
    padding: 5em var(--container-padding) 5em 5em;
  }
  .cta__content {
    max-width: 34em;
    color: var(--color-white);
  }
  .cta__eyebrow {
    color: var(--color-salmon);
  }
  .cta__title {
    margin-top: 0.5em;
    font-size: 4em;
    line-height: 1;
    letter-spacing: -1.8px;
  }
  .cta__title-accent {
    color: var(--color-salmon);
  }
  .cta__lead {
    margin-top: 1em;
    font-weight: 600;
    font-size: 1.125em;
    line-height: 1.4;
  }
  .cta__body {
    margin-top: 1em;
    font-size: 1.25em;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.85);
  }
  .cta__body--breaks { white-space: pre-line; }
  .cta :global(.cta__cta) { margin-top: 1.75em; }
  .cta__form {
    display: flex;
    flex-direction: column;
    gap: 1em;
    margin-top: 2em;
  }
  .cta__form input {
    padding: 1.1em 1.25em;
    background-color: var(--color-white);
    color: var(--color-text);
    border: none;
    font-size: 0.95em;
    letter-spacing: 0.5px;
  }
  .cta__form input::placeholder {
    color: #8a8a8a;
    letter-spacing: 0.5px;
  }
  .cta__submit {
    width: 100%;
  }

  @media (max-width: 991px) {
    .cta__panel {
      padding: 3.5em var(--container-padding);
    }
    .cta__title {
      font-size: 3.25em;
    }
  }
  @media (max-width: 767px) {
    .cta {
      grid-template-columns: 1fr;
    }
    .cta__title { font-size: 2.5em; }
    .cta__media {
      order: 2;
      aspect-ratio: 4 / 3;
    }
    .cta__panel {
      order: 1;
      padding: 3em var(--container-padding);
    }
  }
</style>
