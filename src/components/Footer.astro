<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__row">
      <p class="footer__copy">&copy; 2026 Jenessa Wait. All rights reserved</p>
      <a class="footer__link" href="#">Policies and Terms</a>
      <a class="footer__credit" href="https://www.thelaunchpeople.com/" target="_blank" rel="noopener noreferrer">Website by TLP</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    width: 100%;
    background-color: var(--color-dark);
    color: rgba(255, 255, 255, 0.7);
  }
  .footer__inner {
    padding-block: 2.5em;
  }
  .footer__row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5em;
    padding-top: 2.5em;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    font-size: 0.95em;
  }
  .footer__copy {
    justify-self: start;
  }
  .footer__link {
    justify-self: center;
    transition: color var(--transition-fast);
  }
  .footer__link:hover {
    color: var(--color-white);
  }
  .footer__credit {
    justify-self: end;
    transition: color var(--transition-fast);
  }
  .footer__credit:hover {
    color: var(--color-white);
  }

  @media (max-width: 767px) {
    .footer__row {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 1em;
    }
    .footer__copy,
    .footer__link,
    .footer__credit {
      justify-self: center;
    }
  }
</style>
