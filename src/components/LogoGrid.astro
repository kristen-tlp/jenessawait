---
import { retailers } from "../data/retailers.ts";

export interface Props {
  variant: "white" | "blue";
  keys: string[];
  layout?: "row" | "grid";
}
const { variant, keys, layout = "row" } = Astro.props;
---

<ul class={`logos logos--${layout}`}>
  {keys.map((k) => {
    const r = retailers[k];
    const img = `/assets/images/logos/${variant}-${k}.png`;
    return (
      <li class="logos__item">
        {r.url ? (
          <a href={r.url} target="_blank" rel="noopener noreferrer" aria-label={`Pre-order at ${r.label}`}>
            <img src={img} alt={r.label} loading="lazy" />
          </a>
        ) : (
          <img src={img} alt={r.label} loading="lazy" />
        )}
      </li>
    );
  })}
</ul>

<style>
  .logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5em 2.75em;
  }
  .logos--grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2em 2.5em;
    place-items: center;
  }
  .logos__item {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.5em;
  }
  .logos__item a {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    transition: opacity var(--transition-fast);
  }
  .logos__item a:hover {
    opacity: 0.7;
  }
  /* Cap each logo in a uniform box so wide/tall marks read at the same weight */
  .logos__item img {
    max-height: 2.5em;
    max-width: 9.5em;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  @media (max-width: 991px) {
    .logos--grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 767px) {
    .logos--grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75em 1.5em;
    }
    .logos__item {
      height: 2.1em;
    }
    .logos__item img {
      max-height: 2.1em;
      max-width: 8em;
    }
  }
</style>
