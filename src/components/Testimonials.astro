---
import { getHome, img } from "../lib/cms";
const home = await getHome();
const d = home!.testimonials;
const cards = d.cards.map((c) => ({ ...c, img: img(c.img) }));
---

<section class="tst" aria-labelledby="tst-title">
  <div class="tst__inner container">
    <header class="tst__head">
      <p class="section-label tst__eyebrow">{d.eyebrow}</p>
      <h2 id="tst-title" class="tst__title">
        {d.titleBefore} <span class="tst__title-accent">{d.titleAccent}</span>
      </h2>
    </header>

    <div class="tst__grid">
      {cards.map((c) => (
        <figure class={`quote quote--${c.theme}`}>
          <svg class="quote__mark" viewBox="0 0 32 24" aria-hidden="true">
            <path d="M0 24V13.2C0 5.9 4.6 1 12 0l1.4 3.4C9.2 4.6 6.8 7 6.6 10.4H12V24H0Zm18 0V13.2C18 5.9 22.6 1 30 0l1.4 3.4C27.2 4.6 24.8 7 24.6 10.4H30V24H18Z" fill="currentColor" />
          </svg>
          <blockquote>
            <p class="quote__heading">{c.heading}</p>
            <p class="quote__body">{c.quote}</p>
          </blockquote>
          <figcaption class="quote__cite">
            <img src={c.img} alt={c.name} width="56" height="56" loading="lazy" />
            <span>
              <span class="quote__name">{c.name}</span>
              <span class="quote__role">{c.role}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .tst {
    width: 100%;
    background-color: var(--color-cream-soft);
  }
  .tst__inner {
    padding-block: 5em;
  }
  .tst__eyebrow {
    color: var(--color-dark);
  }
  .tst__title {
    margin-top: 0.5em;
    max-width: 14em;
    color: var(--color-dark);
    font-size: 4em;
    line-height: 1.02;
    letter-spacing: -2px;
  }
  .tst__title-accent {
    color: var(--color-blue);
  }

  .tst__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2em;
    margin-top: 3em;
    align-items: stretch;
  }
  .quote {
    display: flex;
    flex-direction: column;
    padding: 2.5em;
  }
  .quote__mark {
    width: 2em;
    height: 1.5em;
  }
  .quote__heading {
    margin-top: 1.5em;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.5em;
    line-height: 1.12;
    letter-spacing: -0.5px;
  }
  .quote__body {
    margin-top: 1.15em;
    margin-bottom: 2em;
    font-size: 1.125em;
    line-height: 1.5;
  }
  .quote__cite {
    display: flex;
    align-items: center;
    gap: 1em;
    margin-top: auto;
  }
  .quote__cite img {
    width: 3.25em;
    height: 3.25em;
    object-fit: cover;
    flex: none;
  }
  .quote__name,
  .quote__role {
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1.3;
  }
  .quote__name {
    font-weight: 600;
    font-size: 0.875em;
  }
  .quote__role {
    font-size: 0.8em;
    opacity: 0.8;
  }

  /* Themes */
  .quote--pink {
    background-color: var(--color-pink);
    color: var(--color-text);
  }
  .quote--pink .quote__mark,
  .quote--pink .quote__heading,
  .quote--pink .quote__name,
  .quote--pink .quote__role {
    color: var(--color-terracotta);
  }
  .quote--dark {
    background-color: var(--color-dark);
    color: rgba(255, 255, 255, 0.85);
  }
  .quote--dark .quote__mark,
  .quote--dark .quote__heading,
  .quote--dark .quote__name,
  .quote--dark .quote__role {
    color: var(--color-white);
  }
  .quote--periwinkle {
    background-color: var(--color-periwinkle);
    color: var(--color-text);
  }
  .quote--periwinkle .quote__mark,
  .quote--periwinkle .quote__heading,
  .quote--periwinkle .quote__name,
  .quote--periwinkle .quote__role {
    color: var(--color-blue);
  }
  .quote--cream {
    background-color: var(--color-cream);
    color: var(--color-text);
  }
  .quote--cream .quote__mark,
  .quote--cream .quote__heading,
  .quote--cream .quote__name,
  .quote--cream .quote__role {
    color: var(--color-dark);
  }

  @media (max-width: 991px) {
    .tst__title {
      font-size: 3.25em;
    }
  }
  @media (max-width: 767px) {
    .tst__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
