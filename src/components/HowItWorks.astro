---
import LogoGrid from "./LogoGrid.astro";
import { howItWorksKeys } from "../data/retailers.ts";
import { getHome } from "../lib/cms";
const home = await getHome();
const d = home!.howItWorks;
---

<section class="hiw" id="how-it-works" aria-labelledby="hiw-title">
  <div class="hiw__inner container">
    <div class="hiw__banner">
      <svg class="hiw__asterisk" width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
        <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <line x1="12" y1="3" x2="12" y2="21" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="5.6" y1="5.6" x2="18.4" y2="18.4" />
          <line x1="18.4" y1="5.6" x2="5.6" y2="18.4" />
        </g>
      </svg>
      <h2 id="hiw-title">{d.heading}</h2>
    </div>

    <ol class="hiw__steps">
      <li class="step">
        <div class="step__label">
          <span class="step__num">1</span>
          <p class="step__text">{d.step1}</p>
        </div>
        <div class="step__content">
          <LogoGrid variant="blue" keys={howItWorksKeys} layout="grid" />
        </div>
      </li>

      <li class="step">
        <div class="step__label">
          <span class="step__num">2</span>
          <p class="step__text">{d.step2}</p>
        </div>
        <div class="step__content">
          <div class="hiw__form">
            <div class="klaviyo-form-SrpDXz"></div>
          </div>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .hiw {
    width: 100%;
    background-color: var(--color-periwinkle);
  }
  .hiw__inner {
    padding-block: 2em 5em;
  }
  .hiw__banner {
    display: inline-flex;
    align-items: center;
    gap: 0.75em;
    padding: 1em 2em;
    background-color: var(--color-blue);
    color: var(--color-white);
  }
  .hiw__asterisk {
    width: 1.75em;
    height: 1.75em;
    flex: none;
  }
  .hiw__banner h2 {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.5em;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .hiw__steps {
    margin-top: 3em;
    display: flex;
    flex-direction: column;
    gap: 3em;
  }
  .step {
    display: grid;
    grid-template-columns: 18em 1fr;
    gap: 2em;
    align-items: start;
  }
  .step__label {
    display: flex;
    align-items: flex-start;
    gap: 1em;
  }
  .step__num {
    font-family: var(--font-heading);
    color: var(--color-blue);
    font-size: 4em;
    line-height: 0.8;
  }
  .step__text {
    font-size: 1.375em;
    line-height: 1.25;
    color: var(--color-dark);
    padding-top: 0.35em;
  }
  .step__content :global(.logos--grid) {
    width: 100%;
    gap: 2.25em 3em;
  }
  .step__content :global(.logos--grid .logos__item) {
    height: 3.25em;
    width: 100%;
    overflow: hidden;
  }
  .step__content :global(.logos--grid .logos__item img) {
    max-height: 3.25em;
    max-width: 100%;
  }

  /* Blue panel around the embedded Klaviyo claim form (matches the mockup) */
  .hiw__form {
    background-color: var(--color-blue);
    padding: 2.5em;
    max-width: 40em;
  }
  /* let the Klaviyo form fill the panel width */
  .hiw__form :global(.klaviyo-form-SrpDXz) {
    width: 100%;
  }

  @media (max-width: 991px) {
    .step {
      grid-template-columns: 14em 1fr;
    }
  }
  @media (max-width: 767px) {
    .step {
      grid-template-columns: 1fr;
      gap: 1em;
    }
  }
  @media (max-width: 767px) {
    .hiw__form {
      max-width: none;
    }
  }
  @media (max-width: 479px) {
    .hiw__form {
      padding: 1.75em;
    }
  }
</style>
