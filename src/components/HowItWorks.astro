---
import LogoGrid from "./LogoGrid.astro";
import { howItWorksKeys } from "../data/retailers.ts";
import { getHome } from "../lib/cms";
const home = await getHome();
const d = home!.howItWorks;
// The pre-order "claim your bonuses" flow (numbered steps + order-number form)
// is retired at launch. This section now simply points buyers at the retailers.
// Heading comes from the CMS when set, with a launch-appropriate fallback.
const heading = d?.heading?.trim() || "Order the book";
---

<section class="hiw" id="how-it-works" aria-labelledby="hiw-title">
  <div class="hiw__inner container">
    <div class="hiw__banner">
      <svg class="hiw__asterisk" width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
        <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <line x1="12" y1="3" x2="12" y2="21" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="5.6" y1="5.6" x2="18.4" y2="18.4" />
          <line x1="18.4" y1="5.6" x2="5.6" y2="18.4" />
        </g>
      </svg>
      <h2 id="hiw-title">{heading}</h2>
    </div>

    <div class="hiw__retailers">
      <LogoGrid variant="blue" keys={howItWorksKeys} layout="grid" />
    </div>
  </div>
</section>

<style>
  .hiw {
    width: 100%;
    background-color: var(--color-periwinkle);
  }
  .hiw__inner {
    padding-block: 2em 5em;
  }
  .hiw__banner {
    display: inline-flex;
    align-items: center;
    gap: 0.75em;
    padding: 1em 2em;
    background-color: var(--color-blue);
    color: var(--color-white);
  }
  .hiw__asterisk {
    width: 1.75em;
    height: 1.75em;
    flex: none;
  }
  .hiw__banner h2 {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.5em;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .hiw__retailers {
    margin-top: 3em;
  }
  .hiw__retailers :global(.logos--grid) {
    width: 100%;
    gap: 2.25em 3em;
  }
  .hiw__retailers :global(.logos--grid .logos__item) {
    height: 3.25em;
    width: 100%;
    overflow: hidden;
  }
  .hiw__retailers :global(.logos--grid .logos__item img) {
    max-height: 3.25em;
    max-width: 100%;
  }
</style>
