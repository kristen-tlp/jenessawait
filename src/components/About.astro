---
import Button from "./Button.astro";
import { getHome, img } from "../lib/cms";
const home = await getHome();
const d = home!.about;
---

<section class="about" aria-labelledby="about-title">
  <div class="about__inner container">
    <div class="about__grid">
      <div class="about__head">
        <p class="section-label about__eyebrow">{d.eyebrow}</p>
        <h2 id="about-title" class="about__title">
          {d.titleTop}<br /><span class="about__title-accent">{d.titleAccent}</span>
        </h2>
      </div>

      <div class="about__photo img-zoom">
        <img
          src={img(d.image)}
          alt="Jenessa Wait with her husband Ben and their three children"
          width="400"
          height="405"
          loading="lazy"
        />
      </div>

      <div class="about__body">
        <p class="about__text">{d.body1}</p>
        <p class="about__pull">{d.pull}</p>
        <p class="about__text">{d.body2}</p>
        <Button href={d.ctaHref} label={d.ctaLabel} variant="primary" class="about__cta" />
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    width: 100%;
    background-color: var(--color-cream-soft);
  }
  .about__inner {
    padding-block: 5em;
  }
  .about__grid {
    display: grid;
    grid-template-columns: 26em 1fr;
    grid-template-areas:
      "head body"
      "photo body";
    column-gap: 4em;
    row-gap: 1.5em;
    align-items: start;
  }
  .about__head { grid-area: head; }
  .about__photo { grid-area: photo; align-self: start; aspect-ratio: 1 / 1; }
  .about__body { grid-area: body; }

  .about__eyebrow { color: var(--color-dark); }
  .about__title {
    margin-top: 0.5em;
    color: var(--color-dark);
    font-size: 4.5em;
    line-height: 0.98;
    letter-spacing: -2px;
  }
  .about__title-accent { color: var(--color-blue); }
  .about__photo {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .about__photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .about__text {
    font-size: 1.25em;
    line-height: 1.55;
    color: var(--color-text);
  }
  .about__text strong { font-weight: 600; }
  .about__pull {
    margin-block: 2.25em;
    font-family: var(--font-heading);
    font-weight: 400;
    color: var(--color-dark);
    font-size: 1.875em;
    line-height: 1.2;
    letter-spacing: -0.6px;
  }
  /* button class is passed to the Button component (different scope) — needs :global */
  .about__body :global(.about__cta) { margin-top: 4em; }

  @media (max-width: 991px) {
    .about__grid {
      grid-template-columns: 20em 1fr;
      column-gap: 2.5em;
    }
    .about__title { font-size: 3.5em; }
  }
  @media (max-width: 767px) {
    .about__grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        "head"
        "body"
        "photo";
      row-gap: 2em;
    }
    .about__photo { max-width: 26em; align-self: start; aspect-ratio: 1 / 1; }
  }
</style>
