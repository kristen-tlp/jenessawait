---
import Button from "./Button.astro";
import { getHome, img } from "../lib/cms";
const home = await getHome();
const d = home!.sidelined;
---

<section class="sidelined" aria-labelledby="sidelined-title">
  <div class="sidelined__panel">
    <div class="sidelined__content">
      <h2 id="sidelined-title" class="sidelined__title">
        {d.titleBefore} <span class="u-underline">{d.titleWord}<img class="hand-underline" src="/assets/images/line-not.png" alt="" aria-hidden="true" /></span> {d.titleAfter}
      </h2>
      <p class="sidelined__body">{d.body}</p>
      <p class="sidelined__lede">{d.lede}</p>
      <Button href={d.ctaHref} label={d.ctaLabel} variant="primary" />
    </div>
  </div>
  <div class="sidelined__media img-zoom">
    <img
      src={img(d.image)}
      alt="Jenessa Wait walking along a path outdoors"
      width="570"
      height="763"
      loading="lazy"
    />
  </div>
</section>

<style>
  .sidelined {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    background-color: var(--color-cream-soft);
  }
  .sidelined__panel {
    display: flex;
    align-items: center;
    padding: 5em 5em 5em var(--container-padding);
  }
  .sidelined__content {
    max-width: 34em;
  }
  .sidelined__title {
    color: var(--color-dark);
    font-size: 4em;
    line-height: 1.02;
    letter-spacing: -1.8px;
  }
  .u-underline {
    position: relative;
    white-space: nowrap;
  }
  .u-underline .hand-underline {
    position: absolute;
    left: 0;
    bottom: 0.1em;
    width: 100%;
    height: auto;
    display: block;
  }
  .sidelined__body {
    margin-top: 1.5em;
    font-size: 1.25em;
    line-height: 1.4;
    color: var(--color-text);
  }
  .sidelined__lede {
    margin-top: 1.5em;
    font-family: var(--font-heading);
    font-weight: 400;
    color: var(--color-dark);
    font-size: 1.75em;
    line-height: 1.15;
    letter-spacing: -0.7px;
    white-space: pre-line;
  }
  .sidelined__content :global(.btn) {
    margin-top: 1.75em;
  }
  .sidelined__media {
    min-height: 100%;
  }
  .sidelined__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 991px) {
    .sidelined__panel {
      padding: 3.5em var(--container-padding);
    }
    .sidelined__title {
      font-size: 3.25em;
    }
  }
  @media (max-width: 767px) {
    .sidelined {
      grid-template-columns: 1fr;
    }
    .sidelined__panel {
      padding: 3em var(--container-padding);
    }
    /* Figma mobile omits the photo in this section */
    .sidelined__media {
      display: none;
    }
  }
</style>
