---
export const prerender = true;
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../keystatic.config";
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";

// Editable in the CMS: /keystatic → Thank-You Page
const reader = createReader(process.cwd(), keystaticConfig);
const ty = await reader.singletons.thankYou.read();

const pageTitle = "You're In! — The Moving With God Challenge";
const pageDescription =
  "You're signed up for the free Moving With God 9-Day Challenge. Here's what happens next.";

// Normalize image field values (Keystatic stores the filename) into a src path.
const img = (v?: string | null) =>
  !v ? "" : v.startsWith("/") || v.startsWith("http") ? v : `/assets/images/${v}`;
---

<BaseLayout title={pageTitle} description={pageDescription} noindex={true}>
  <main id="main">
    <section class="ty">
      <div class="ty__inner container">
        <div class="ty__media">
          <img
            src={img(ty?.photo)}
            alt="Jenessa Wait"
            width="1200"
            height="1800"
            loading="eager"
          />
        </div>

        <div class="ty__content">
          <p class="section-label ty__eyebrow">{ty?.eyebrow}</p>
          <h1 class="ty__title">{ty?.heading}</h1>
          <p class="ty__lede">{ty?.lede}</p>

          <ol class="ty__steps">
            {ty?.steps.map((s, i) => (
              <li class="ty__step">
                <span class="ty__num">{i + 1}</span>
                <p class="ty__step-text">
                  {s.linkUrl ? (
                    <><a href={s.linkUrl} download={s.linkDownload || undefined}>{s.linkLabel}</a> — {s.text}</>
                  ) : (
                    s.text
                  )}
                </p>
              </li>
            ))}
          </ol>

          <div class="ty__book">
            <img
              src={img(ty?.bookImage)}
              alt="Moving with God book by Jenessa Wait"
              width="1000"
              height="1500"
              loading="lazy"
            />
            <p class="ty__book-text">
              {ty?.bookText}{" "}
              <a href={ty?.bookLinkUrl}>{ty?.bookLinkLabel}</a>.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .ty {
    width: 100%;
    background-color: var(--color-cream-soft);
  }
  .ty__inner {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 4.5em;
    align-items: stretch;
    padding-block: 5.5em;
  }

  /* Portrait — fills the column so its bottom lines up with the book box */
  .ty__media {
    align-self: stretch;
    position: relative;
    min-height: 24em;
  }
  .ty__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
  }

  /* Content */
  .ty__content { max-width: 34em; }
  .ty__eyebrow { color: var(--color-terracotta); }
  .ty__title {
    margin-top: 0.35em;
    color: var(--color-blue);
    font-size: 6em;
    line-height: 0.95;
    letter-spacing: -2.5px;
  }
  .ty__lede {
    margin-top: 0.75em;
    font-size: 1.375em;
    line-height: 1.45;
    color: var(--color-text);
  }

  .ty__steps {
    list-style: none;
    margin-top: 2.25em;
    display: flex;
    flex-direction: column;
    gap: 1.5em;
  }
  .ty__step {
    display: grid;
    grid-template-columns: 1.75em 1fr;
    gap: 1.25em;
    align-items: baseline;
  }
  .ty__num {
    font-family: var(--font-heading);
    font-size: 1.75em;
    line-height: 1;
    color: var(--color-terracotta);
  }
  .ty__step-text {
    font-size: 1.1875em;
    line-height: 1.45;
    color: var(--color-text);
  }
  .ty__step-text a {
    color: var(--color-blue);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.15em;
    transition: color var(--transition-fast);
  }
  .ty__step-text a:hover { color: var(--color-terracotta); }

  /* Book cross-sell */
  .ty__book {
    margin-top: 3em;
    padding: 2em 2.25em;
    background-color: var(--color-pink);
    display: flex;
    align-items: center;
    gap: 1.75em;
  }
  .ty__book img {
    flex: none;
    width: 6.5em;
    height: auto;
    box-shadow: 0 12px 30px rgba(57, 51, 49, 0.16);
  }
  .ty__book-text {
    font-size: 1.1875em;
    line-height: 1.45;
    color: var(--color-text);
  }
  .ty__book-text a {
    color: var(--color-blue);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.15em;
    transition: color var(--transition-fast);
  }
  .ty__book-text a:hover { color: var(--color-terracotta); }

  @media (max-width: 991px) {
    .ty__inner { gap: 3em; }
    .ty__title { font-size: 4.5em; }
  }
  @media (max-width: 767px) {
    .ty__inner {
      grid-template-columns: 1fr;
      gap: 2.5em;
      padding-block: 3.5em;
    }
    .ty__media img { max-height: 26em; }
    .ty__title { font-size: 4em; }
    .ty__book { flex-direction: column; align-items: center; text-align: center; gap: 1.25em; }
  }
</style>
