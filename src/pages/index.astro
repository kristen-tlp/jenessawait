---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import PressBar from "../components/PressBar.astro";
import Sidelined from "../components/Sidelined.astro";
import Inside from "../components/Inside.astro";
import Bonuses from "../components/Bonuses.astro";
import Giveaway from "../components/Giveaway.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Testimonials from "../components/Testimonials.astro";
import ChallengeCTA from "../components/ChallengeCTA.astro";
import About from "../components/About.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout>
  <Nav />
  <main id="main">
    <Hero />
    <PressBar />
    <Sidelined />
    <Inside />
    <Bonuses />
    <Giveaway />
    <HowItWorks />
    <Testimonials />
    <ChallengeCTA />
    <About />
  </main>
  <Footer />
</BaseLayout>
