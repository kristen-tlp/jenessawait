---
export const prerender = true;
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../keystatic.config";
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro";

// Editable in the CMS: /keystatic → Challenge Page
const reader = createReader(process.cwd(), keystaticConfig);
const c = await reader.singletons.challenge.read();

const pageTitle = "The Moving With God Challenge — Free 9-Day Journey with Jenessa Wait";
const pageDescription =
  "A free, guided 9-day challenge to help you get unstuck, quiet the noise, and take your next faithful step with God. Sign up free and start moving with God.";

// Normalize image field values (Keystatic stores the filename) into a src path.
const img = (v?: string | null) =>
  !v ? "" : v.startsWith("/") || v.startsWith("http") ? v : `/assets/images/${v}`;

// Aliases so the section markup below reads cleanly.
const hero = c!.hero;
const empathy = c!.empathy;
const empathyLines = empathy.lines;
const steps = c!.steps.items;
const receive = c!.receive.items;
const journey = c!.journey.items;
const about = c!.about;
const book = c!.book;
const finalCta = c!.finalCta;
const faqs = c!.faq.items;
const endorsements = c!.endorsements.items.map((e) => ({ ...e, img: img(e.img) }));
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main">
    <!-- 1. HERO -->
    <section class="hero" id="join" aria-labelledby="hero-title">
      <div class="hero__panel">
        <div class="hero__content">
          <p class="section-label hero__eyebrow">{hero.eyebrow}</p>
          <h1 id="hero-title" class="hero__title"><span class="hero__title-accent">{hero.titleAccent}</span> {hero.titleRest}</h1>
          <p class="hero__lede">{hero.lede}</p>
          <div class="hero__form">
            <!-- Klaviyo challenge signup form (renders on the live/allowlisted domain) -->
            <div class="klaviyo-form-Rvq64Z"></div>
          </div>
          <p class="hero__reassure">{hero.reassure}</p>
        </div>
      </div>
      <div class="hero__media">
        <img src={img(hero.image)} alt="Jenessa Wait holding the Moving with God book" width="1200" height="1800" loading="eager" />
      </div>
    </section>

    <!-- 2. EMPATHY (inline-image statement) -->
    <section class="empathy" aria-labelledby="empathy-title">
      <div class="empathy__inner container">
        <h2 id="empathy-title" class="empathy__statement">{empathy.statementBefore} <span class="u-underline">{empathy.statementWord}<img class="hand-underline" src="/assets/images/line-not.png" alt="" aria-hidden="true" /></span> {empathy.statementAfter}</h2>

        <div class="empathy__grid">
          <div class="empathy__col">
            <p class="empathy__intro">{empathy.intro}</p>
            <p class="empathy__close">{empathy.close}</p>
          </div>
          <ul class="empathy__list">
            {empathyLines.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 3. HOW THE CHALLENGE WORKS -->
    <section class="steps" aria-labelledby="steps-title">
      <div class="steps__inner container">
        <header class="section-head">
          <p class="section-label">{c!.steps.eyebrow}</p>
          <h2 id="steps-title">{c!.steps.heading}</h2>
        </header>
        <ol class="steps__grid">
          {steps.map((s) => (
            <li class="stepcard">
              <span class="stepcard__num">{s.n}</span>
              <h3 class="stepcard__title">{s.title}</h3>
              <p class="stepcard__body">{s.body}</p>
            </li>
          ))}
        </ol>
        <div class="steps__cta">
          <Button href="#join" label="Sign Up Free" variant="primary" />
        </div>
      </div>
    </section>

    <!-- 4. WHAT YOU'LL RECEIVE EACH DAY -->
    <section class="receive" aria-labelledby="receive-title">
      <div class="receive__inner container">
        <header class="section-head">
          <p class="section-label">{c!.receive.eyebrow}</p>
          <h2 id="receive-title">{c!.receive.heading}</h2>
        </header>
        <ul class="receive__list">
          {receive.map((r) => (
            <li class="receive__item">
              <span class="receive__check" aria-hidden="true"></span>
              <div>
                <h3 class="receive__label">{r.title}</h3>
                <p class="receive__body">{r.body}</p>
              </div>
            </li>
          ))}
        </ul>
        <div class="sec-cta">
          <Button href="#join" label="Sign Up Free" variant="light" />
        </div>
      </div>
    </section>

    <!-- 5. THE 9-DAY JOURNEY -->
    <section class="journey" aria-labelledby="journey-title">
      <div class="journey__inner container">
        <header class="section-head">
          <p class="section-label">{c!.journey.eyebrow}</p>
          <h2 id="journey-title">{c!.journey.heading}</h2>
          <p class="journey__note">{c!.journey.note}</p>
        </header>
        <ol class="journey__grid">
          {journey.map((d, i) => (
            <li class={`daycard daycard--${["dark", "peach", "blue", "cream"][i % 4]}`}>
              <span class="daycard__day">{d.day}</span>
              <h3 class="daycard__title">{d.title}</h3>
              <p class="daycard__body">{d.body}</p>
            </li>
          ))}
        </ol>
        <div class="sec-cta">
          <Button href="#join" label="Sign Up Free" variant="primary" />
        </div>
      </div>
    </section>

    <!-- 6. ABOUT JENESSA -->
    <section class="about" aria-labelledby="about-title">
      <div class="about__media">
        <img src={img(about.image)} alt="Jenessa Wait" width="1000" height="1505" loading="lazy" />
      </div>
      <div class="about__panel">
        <div class="about__content">
          <p class="section-label">{about.eyebrow}</p>
          <h2 id="about-title" class="about__title">{about.title}</h2>
          <p class="about__body">{about.body1}</p>
          <p class="about__body">{about.body2}</p>
          <Button href="#join" label={about.ctaLabel} variant="primary" class="about__cta" />
        </div>
      </div>
    </section>

    <!-- 7. ENDORSEMENTS (full-width slider) -->
    <section class="quotes" aria-labelledby="quotes-title">
      <div class="quotes__head container">
        <div>
          <p class="section-label">{c!.endorsements.eyebrow}</p>
          <h2 id="quotes-title" class="quotes__title">{c!.endorsements.heading} <span class="quotes__accent">{c!.endorsements.headingAccent}</span></h2>
        </div>
        <div class="slider__nav">
          <button class="slider__arrow" type="button" aria-label="Previous endorsement" data-prev>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="slider__arrow" type="button" aria-label="Next endorsement" data-next>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
      <ul class="slider__track" data-track>
        {endorsements.map((c) => (
          <li class={`eqcard eqcard--${c.theme}`}>
            <svg class="eqcard__mark" viewBox="0 0 32 24" aria-hidden="true">
              <path d="M0 24V13.2C0 5.9 4.6 1 12 0l1.4 3.4C9.2 4.6 6.8 7 6.6 10.4H12V24H0Zm18 0V13.2C18 5.9 22.6 1 30 0l1.4 3.4C27.2 4.6 24.8 7 24.6 10.4H30V24H18Z" fill="currentColor" />
            </svg>
            <p class="eqcard__heading">{c.heading}</p>
            <p class="eqcard__body">{c.quote}</p>
            <div class="eqcard__cite">
              <img src={c.img} alt={c.name} width="56" height="56" loading="lazy" />
              <span>
                <span class="eqcard__name">{c.name}</span>
                <span class="eqcard__role">{c.role}</span>
              </span>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- 8. BOOK COMPANION -->
    <section class="book" aria-labelledby="book-title">
      <div class="book__inner container">
        <div class="book__media">
          <img src={img(book.image)} alt="Moving with God book by Jenessa Wait" width="1200" height="1800" loading="lazy" />
        </div>
        <div class="book__content">
          <p class="section-label book__eyebrow">{book.eyebrow}</p>
          <h2 id="book-title" class="book__title">{book.titleLine1}<br />{book.titleLine2}</h2>
          <p class="book__body">{book.body}</p>
          <p class="book__meta">{book.meta}</p>
          <Button href={book.ctaUrl} label={book.ctaLabel} variant="primary" class="book__cta" />
        </div>
      </div>
    </section>

    <!-- 9. FAQ -->
    <section class="faq" aria-labelledby="faq-title">
      <div class="faq__inner container">
        <header class="section-head">
          <p class="section-label">{c!.faq.eyebrow}</p>
          <h2 id="faq-title">{c!.faq.heading}</h2>
        </header>
        <div class="faq__list">
          {faqs.map((f, i) => (
            <details class="faq__item" open={i === 0}>
              <summary class="faq__q">
                {f.q}
                <span class="faq__icon" aria-hidden="true"></span>
              </summary>
              <p class="faq__a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 10. FINAL CTA -->
    <section class="final" aria-labelledby="final-title">
      <div class="final__media">
        <img src={img(finalCta.image)} alt="Jenessa Wait smiling" width="1200" height="1800" loading="lazy" />
      </div>
      <div class="final__panel">
        <div class="final__content">
          <h2 id="final-title" class="final__title">{finalCta.title}</h2>
          <p class="final__body">{finalCta.body}</p>
          <Button href="#join" label={finalCta.ctaLabel} variant="primary" class="final__cta" />
          <p class="final__reassure">{finalCta.reassure}</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script is:inline>
    (() => {
      const track = document.querySelector("[data-track]");
      if (!track) return;
      const amount = () => Math.min(track.clientWidth * 0.85, 480);
      const prev = document.querySelector("[data-prev]");
      const next = document.querySelector("[data-next]");
      if (prev) prev.addEventListener("click", () => track.scrollBy({ left: -amount(), behavior: "smooth" }));
      if (next) next.addEventListener("click", () => track.scrollBy({ left: amount(), behavior: "smooth" }));
    })();
  </script>
</BaseLayout>

<style>
  /* ---------- Shared section head ---------- */
  .section-head {
    max-width: 40em;
    margin-inline: auto;
    text-align: center;
    margin-bottom: 3em;
  }
  .section-head h2 {
    margin-top: 0.4em;
    color: var(--color-blue);
    font-size: 3.5em;
    line-height: 1;
    letter-spacing: -1.5px;
  }

  /* ---------- 1. Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    background-color: var(--color-blue);
  }
  .hero__panel {
    display: flex;
    align-items: center;
    padding: 5.5em 4em 5.5em var(--container-padding);
  }
  .hero__content { max-width: 27em; color: var(--color-white); }
  .hero__eyebrow { color: var(--color-salmon); }
  .hero__title {
    margin-top: 0.5em;
    color: var(--color-white);
    font-size: 4em;
    line-height: 1;
    letter-spacing: -2px;
  }
  .hero__title-accent { color: var(--color-salmon); }
  .hero__lede {
    margin-top: 0.9em;
    font-size: 1.25em;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.85);
  }
  .hero__form { margin-top: 1.75em; }
  .hero__reassure {
    margin-top: 1.25em;
    font-size: 0.9375em;
    color: rgba(255, 255, 255, 0.7);
  }
  .hero__media { min-height: 100%; position: relative; }
  .hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
  }

  /* ---------- 2. Empathy ---------- */
  .empathy { width: 100%; background-color: var(--color-periwinkle); }
  .empathy__inner { padding-top: 6em; padding-bottom: 3em; }
  .empathy__statement {
    max-width: 14em;
    font-family: var(--font-heading);
    font-weight: 400;
    color: var(--color-blue);
    font-size: 4em;
    line-height: 1.05;
    letter-spacing: -1.5px;
    text-wrap: balance;
  }
  .empathy__statement .u-underline { position: relative; white-space: nowrap; }
  .empathy__statement .hand-underline {
    position: absolute;
    left: 0;
    bottom: 0.04em;
    width: 100%;
    height: auto;
    display: block;
  }
  .empathy__grid {
    margin-top: 3em;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5em;
    align-items: start;
  }
  .empathy__intro {
    font-size: 1.375em;
    line-height: 1.5;
    color: var(--color-text);
  }
  .empathy__close {
    margin-top: 1.25em;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.75em;
    line-height: 1.2;
    letter-spacing: -0.5px;
    color: var(--color-blue);
  }
  .empathy__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.1em;
  }
  .empathy__list li {
    position: relative;
    padding-left: 1.6em;
    font-size: 1.25em;
    line-height: 1.4;
    color: var(--color-text);
  }
  .empathy__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.45em;
    height: 0.45em;
    border-radius: 50%;
    background-color: var(--color-terracotta);
  }

  /* ---------- 3. Steps ---------- */
  .steps { width: 100%; background-color: var(--color-periwinkle); }
  .steps__inner { padding-top: 3em; padding-bottom: 5.5em; }
  .steps__grid {
    list-style: none;
    display: flex;
    align-items: stretch;
    justify-content: center;
  }
  .stepcard {
    position: relative;
    flex: 1 1 0;
    background-color: var(--color-cream);
    padding: 2.75em 2em 3em;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    box-shadow: 0 14px 34px rgba(57, 51, 49, 0.13);
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* gentle stacked rotation + slight overlap (like "Inside Moving with God") */
  .stepcard:not(:first-child) { margin-left: -1.25em; }
  .stepcard:nth-child(1) { transform: rotate(-2deg); z-index: 1; }
  .stepcard:nth-child(2) { transform: rotate(1.5deg); z-index: 3; }
  .stepcard:nth-child(3) { transform: rotate(-1.5deg); z-index: 2; }
  .stepcard:hover { transform: rotate(0deg) scale(1.02); z-index: 4; }
  .steps__cta { margin-top: 4em; text-align: center; }
  .sec-cta { margin-top: 3.5em; text-align: center; }
  .stepcard__num {
    font-family: var(--font-heading);
    color: var(--color-terracotta);
    font-size: 3.5em;
    line-height: 0.8;
  }
  .stepcard__title {
    margin-top: 0.5em;
    font-size: 1.625em;
    line-height: 1.1;
    letter-spacing: -0.5px;
    color: var(--color-dark);
  }
  .stepcard__body {
    margin-top: 0.6em;
    font-size: 1.125em;
    line-height: 1.45;
    color: var(--color-text);
  }

  /* ---------- 4. Receive ---------- */
  .receive { width: 100%; background-color: var(--color-blue); color: var(--color-white); }
  .receive__inner { padding-block: 5.5em; }
  .receive .section-head h2 { color: var(--color-white); }
  .receive .section-label { color: rgba(255, 255, 255, 0.7); }
  .receive__list {
    list-style: none;
    max-width: 44em;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 1.5em;
  }
  .receive__item {
    display: flex;
    gap: 1.1em;
    align-items: flex-start;
    padding-bottom: 1.5em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
  }
  .receive__item:last-child { border-bottom: none; padding-bottom: 0; }
  .receive__check {
    flex: none;
    margin-top: 0.35em;
    width: 0.55em;
    height: 0.95em;
    border: solid var(--color-salmon);
    border-width: 0 0.18em 0.18em 0;
    transform: rotate(45deg);
  }
  .receive__label {
    font-size: 1.375em;
    line-height: 1.15;
    letter-spacing: -0.4px;
    font-family: var(--font-heading);
    font-weight: 400;
  }
  .receive__body {
    margin-top: 0.35em;
    font-size: 1.0625em;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.85);
  }

  /* ---------- 5. Journey (uses the "What's Inside" card palette) ---------- */
  .journey { width: 100%; background-color: var(--color-periwinkle); }
  .journey__inner { padding-block: 5.5em; }
  .journey__note {
    margin-top: 1em;
    font-size: 0.9375em;
    line-height: 1.5;
    color: var(--color-text);
    opacity: 0.85;
  }
  .journey__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5em;
  }
  .daycard {
    padding: 2em 1.75em 2.25em;
  }
  .daycard__day {
    font-size: 0.8125em;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .daycard__title {
    margin-top: 0.5em;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.625em;
    line-height: 1.05;
    letter-spacing: -0.5px;
  }
  .daycard__body {
    margin-top: 0.6em;
    font-size: 1.0625em;
    line-height: 1.45;
  }
  /* card themes (mirrors Inside Moving with God) */
  .daycard--dark { background-color: var(--color-dark); color: rgba(255, 255, 255, 0.82); }
  .daycard--dark .daycard__title { color: var(--color-white); }
  .daycard--dark .daycard__day { color: var(--color-white); }
  .daycard--peach { background-color: var(--color-card-peach); color: var(--color-dark); }
  .daycard--peach .daycard__title { color: var(--color-dark); }
  .daycard--peach .daycard__day { color: var(--color-terracotta); opacity: 1; }
  .daycard--blue { background-color: var(--color-card-blue); color: var(--color-blue); }
  .daycard--blue .daycard__title { color: var(--color-blue); }
  .daycard--blue .daycard__day { color: var(--color-blue); }
  .daycard--cream { background-color: var(--color-cream); color: var(--color-dark); }
  .daycard--cream .daycard__title { color: var(--color-dark); }
  .daycard--cream .daycard__day { color: var(--color-terracotta); opacity: 1; }

  /* ---------- 6. About ---------- */
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    background-color: var(--color-cream);
  }
  .about__media { min-height: 100%; position: relative; }
  .about__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
  }
  .about__panel {
    display: flex;
    align-items: center;
    padding: 5.5em var(--container-padding) 5.5em 4em;
  }
  .about__content { max-width: 32em; }
  .about__title {
    margin-top: 0.4em;
    color: var(--color-blue);
    font-size: 3.5em;
    line-height: 1;
    letter-spacing: -1.5px;
  }
  .about__body {
    margin-top: 1.25em;
    font-size: 1.25em;
    line-height: 1.55;
    color: var(--color-text);
  }
  .about__content :global(.about__cta) { margin-top: 2em; }

  /* ---------- 7. Endorsements slider ---------- */
  .quotes { width: 100%; background-color: var(--color-cream-soft); padding-block: 5.5em; overflow: hidden; }
  .quotes__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2em;
    margin-bottom: 2.5em;
  }
  .quotes .section-label { color: var(--color-dark); }
  .quotes__title {
    margin-top: 0.4em;
    color: var(--color-dark);
    font-size: 3em;
    line-height: 1.02;
    letter-spacing: -1.5px;
    text-wrap: balance;
  }
  .quotes__accent { color: var(--color-blue); }
  .slider__nav { display: flex; gap: 0.75em; flex: none; }
  .slider__arrow {
    width: 3em;
    height: 3em;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background-color: var(--color-white);
    color: var(--color-dark);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }
  .slider__arrow svg { width: 1.25em; height: 1.25em; }
  .slider__arrow:hover { background-color: var(--color-blue); color: var(--color-white); border-color: var(--color-blue); }

  .slider__track {
    list-style: none;
    display: flex;
    gap: 1.5em;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    /* first card aligns to the page gutter; cards bleed off the right edge */
    padding-inline: max(var(--container-padding), calc((100% - var(--size-container)) / 2 + var(--container-padding)));
    scrollbar-width: none;
  }
  .slider__track::-webkit-scrollbar { display: none; }
  .eqcard {
    scroll-snap-align: start;
    /* ~2 cards visible at a time so the boxes read wider and shorter */
    flex: 0 0 calc((100% - 1.5em) / 2);
    max-width: 90vw;
    display: flex;
    flex-direction: column;
    padding: 2.75em 2.5em;
  }
  .eqcard__mark { width: 2em; height: 1.5em; }
  .eqcard__heading {
    margin-top: 1.25em;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.5em;
    line-height: 1.12;
    letter-spacing: -0.5px;
  }
  .eqcard__body {
    margin-top: 1em;
    margin-bottom: 2em;
    font-size: 1.0625em;
    line-height: 1.5;
  }
