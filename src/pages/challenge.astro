---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro";

const pageTitle = "The Moving With God Challenge — Free 9-Day Journey with Jenessa Wait";
const pageDescription =
  "A free, guided 9-day challenge to help you get unstuck, quiet the noise, and take your next faithful step with God. Sign up free and start moving with God.";

// Steps
const steps = [
  {
    n: "1",
    title: "Sign up free",
    body: "Add your name and email below and we'll save your spot. It takes about ten seconds.",
  },
  {
    n: "2",
    title: "Open your daily email",
    body: "Each morning for nine days, a short message lands in your inbox — one key, one Scripture, and one small step.",
  },
  {
    n: "3",
    title: "Take one step",
    body: "Spend a few quiet minutes responding. No pressure, no catching up — just you and God, one day at a time.",
  },
];

// What you'll receive each day
const receive = [
  {
    title: "A short daily teaching",
    body: "A few honest, encouraging minutes from Jenessa to ground your day.",
  },
  {
    title: "One key Scripture",
    body: "A verse to carry with you and return to. [Placeholder — final verses to be added.]",
  },
  {
    title: "A simple reflection prompt",
    body: "One gentle question to help you listen and respond.",
  },
  {
    title: "A small, doable step",
    body: "Something you can actually put into practice today — no overwhelm.",
  },
  {
    title: "Space to process",
    body: "Room to journal, pray, and notice where God is already at work.",
  },
];

// The 9-day journey — PLACEHOLDER themes until final chapter titles are provided.
const journey = [
  { day: "Day 1", title: "Naming Where You Feel Stuck", body: "Bring your honest starting place to God — no pretending required." },
  { day: "Day 2", title: "Remembering Who God Is", body: "Return to the character of the One who is leading you." },
  { day: "Day 3", title: "Seeing Where He's Already Moving", body: "Notice the quiet ways God is at work in your life right now." },
  { day: "Day 4", title: "Trusting His Timing", body: "Make peace with the wait without letting go of hope." },
  { day: "Day 5", title: "Releasing What You're Carrying", body: "Set down the striving, the fear, and the comparison." },
  { day: "Day 6", title: "Preparing in the In-Between", body: "Use this season to quietly get ready for what's next." },
  { day: "Day 7", title: "Listening for His Voice", body: "Create space to hear God's direction for your next step." },
  { day: "Day 8", title: "Taking the Next Faithful Step", body: "Move forward with the little you can see in front of you." },
  { day: "Day 9", title: "Moving with God", body: "Step into the promise with confident, hope-filled faith." },
];

// Empathy lines
const empathyLines = [
  "Maybe you feel stuck between where you are and where you believe God is leading you.",
  "Maybe you've prayed the same prayer so long you've started to wonder if He heard it.",
  "Maybe everyone else seems to be moving forward while you're still standing still.",
  "Maybe you're not sure what the next step is — only that you're ready for one.",
];

// FAQ
const faqs = [
  {
    q: "Do I need the book?",
    a: "Not at all. The challenge is completely free and stands on its own. Moving with God is simply an optional way to go deeper after the nine days.",
  },
  {
    q: "How long does each day take?",
    a: "About five to ten minutes. Each day is short and doable — designed to fit into real life, not add pressure to it.",
  },
  {
    q: "Is the challenge free?",
    a: "Yes. It's completely free, from Day 1 to Day 9.",
  },
  {
    q: "Can I start anytime?",
    a: "Yes — sign up whenever you're ready and we'll send your first day so you can begin. [Placeholder — confirm whether the challenge runs on set dates or is available anytime.]",
  },
  {
    q: "How will I receive each day's content?",
    a: "Straight to your inbox. Each morning for nine days you'll get a short email with that day's teaching, Scripture, and step.",
  },
];

// Endorsements — identical to the pre-order page, shown here in a full-width slider.
const endorsements = [
  {
    theme: "pink",
    heading: "What does it look like to move in step with God, not rushing ahead or falling behind?",
    quote:
      "Jenessa Wait is a trusted guide to help you discern God's timing and move forward in confidence through every door He opens.",
    name: "Rebekah Lyons",
    role: "Bestselling Author, Speaker, and Co-Founder of Thinq Media",
    img: "/assets/images/head-rebekah.jpg",
  },
  {
    theme: "dark",
    heading: "Moving with God is not just a message Jenessa Wait teaches; it is a life she has faithfully lived.",
    quote:
      "Walking through surrender, stewardship, service, and bold obedience to God's promises. With clarity and conviction, she offers nine practical and spiritual keys that help readers move from stagnation to possession of what God has spoken. This book will strengthen your faith, challenge unbelief, and anchor you in the house of God as you step courageously into His promises for your life.",
    name: "Joaquin and Renée Evans",
    role: "Senior Pastors of Bethel Austin",
    img: "/assets/images/head-evans.jpg",
  },
  {
    theme: "periwinkle",
    heading: "Jenessa Wait is someone whose life speaks just as powerfully as her words.",
    quote:
      "What has always stood out to me is her persistent teachability. She honors the voices God has placed in her life and leans in to discern what He is saying and where He is leading. In Moving with God, she brings that same grace to the reader, helping you see the Father's heart even in hidden or stretching seasons. With clarity and Spirit-led insight, she offers a practical pathway for partnering with God and stepping into His promises. This book will steady your heart, awaken fresh courage, and remind you that you are not forgotten. God is actively leading you forward right now.",
    name: "Bethany Hicks",
    role: "Co-Founder of Prophetic Company & Author of The God Connection",
    img: "/assets/images/head-bethany.jpg",
  },
  {
    theme: "cream",
    heading: "Jenessa Wait's honest and vulnerable storytelling dismantles the addiction to hustle and calls us back to belief.",
    quote:
      "From the very first page, Jenessa Wait beckons us into a deeper life of faith, trust, and vision. Moving with God serves as both an invitation and a guide into the life we ache for but often struggle to access. This book encourages readers to dream, take risks, and recognize God's presence. It challenges the status quo and invites us into a life marked by surrender and expectancy, emphasizing humility, trust, and laying everything down to truly find life.",
    name: "Jessi Green",
    role: "Author of The Invitation & Wildfires, Co-Lead Pastor of Salt Church",
    img: "/assets/images/head-jessi.jpg",
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main">
    <!-- 1. HERO -->
    <section class="hero" id="join" aria-labelledby="hero-title">
      <div class="hero__panel">
        <div class="hero__content">
          <p class="section-label hero__eyebrow">Free &middot; No Purchase Necessary</p>
          <h1 id="hero-title" class="hero__title"><span class="hero__title-accent">9 Day Challenge:</span> Start moving with God!</h1>
          <p class="hero__lede">
            A free, guided journey to help you get unstuck, quiet the noise, and take your
            next faithful step &mdash; one small, hope-filled day at a time.
          </p>
          <div class="hero__form">
            <!-- Klaviyo challenge signup form (renders on the live/allowlisted domain) -->
            <div class="klaviyo-form-Rvq64Z"></div>
          </div>
          <p class="hero__reassure">100% free &middot; Start anytime &middot; Unsubscribe whenever you like</p>
        </div>
      </div>
      <div class="hero__media">
        <img src="/assets/images/challenge-hero.jpg" alt="Jenessa Wait holding the Moving with God book" width="1200" height="1800" loading="eager" />
      </div>
    </section>

    <!-- 2. EMPATHY (inline-image statement) -->
    <section class="empathy" aria-labelledby="empathy-title">
      <div class="empathy__inner container">
        <h2 id="empathy-title" class="empathy__statement">If your heart is <span class="u-underline">tired<img class="hand-underline" src="/assets/images/line-not.png" alt="" aria-hidden="true" /></span> of waiting, you&rsquo;re in the right place.</h2>

        <div class="empathy__grid">
          <div class="empathy__col">
            <p class="empathy__intro">
              You love God. You believe He&rsquo;s good. And still, somewhere along the way, the
              space between His promise and your right-now started to feel heavy.
            </p>
            <p class="empathy__close">
              Wherever you are, God is still moving &mdash; and over the next nine days, you can
              begin moving with Him.
            </p>
          </div>
          <ul class="empathy__list">
            {empathyLines.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 3. HOW THE CHALLENGE WORKS -->
    <section class="steps" aria-labelledby="steps-title">
      <div class="steps__inner container">
        <header class="section-head">
          <p class="section-label">How It Works</p>
          <h2 id="steps-title">Three simple steps</h2>
        </header>
        <ol class="steps__grid">
          {steps.map((s) => (
            <li class="stepcard">
              <span class="stepcard__num">{s.n}</span>
              <h3 class="stepcard__title">{s.title}</h3>
              <p class="stepcard__body">{s.body}</p>
            </li>
          ))}
        </ol>
        <div class="steps__cta">
          <Button href="#join" label="Sign Up Free" variant="primary" />
        </div>
      </div>
    </section>

    <!-- 4. WHAT YOU'LL RECEIVE EACH DAY -->
    <section class="receive" aria-labelledby="receive-title">
      <div class="receive__inner container">
        <header class="section-head">
          <p class="section-label">Every Day for Nine Days</p>
          <h2 id="receive-title">What you&rsquo;ll receive</h2>
        </header>
        <ul class="receive__list">
          {receive.map((r) => (
            <li class="receive__item">
              <span class="receive__check" aria-hidden="true"></span>
              <div>
                <h3 class="receive__label">{r.title}</h3>
                <p class="receive__body">{r.body}</p>
              </div>
            </li>
          ))}
        </ul>
        <div class="sec-cta">
          <Button href="#join" label="Sign Up Free" variant="light" />
        </div>
      </div>
    </section>

    <!-- 5. THE 9-DAY JOURNEY -->
    <section class="journey" aria-labelledby="journey-title">
      <div class="journey__inner container">
        <header class="section-head">
          <p class="section-label">The Journey</p>
          <h2 id="journey-title">The 9 Day Challenge</h2>
          <p class="journey__note">
            <strong>Note:</strong> the daily themes below are placeholders and will be updated
            with the final chapter themes from <em>Moving with God</em>.
          </p>
        </header>
        <ol class="journey__grid">
          {journey.map((d, i) => (
            <li class={`daycard daycard--${["dark", "peach", "blue", "cream"][i % 4]}`}>
              <span class="daycard__day">{d.day}</span>
              <h3 class="daycard__title">{d.title}</h3>
              <p class="daycard__body">{d.body}</p>
            </li>
          ))}
        </ol>
        <div class="sec-cta">
          <Button href="#join" label="Sign Up Free" variant="primary" />
        </div>
      </div>
    </section>

    <!-- 6. ABOUT JENESSA -->
    <section class="about" aria-labelledby="about-title">
      <div class="about__media">
        <img src="/assets/images/challenge-about.jpg" alt="Jenessa Wait" width="1000" height="1505" loading="lazy" />
      </div>
      <div class="about__panel">
        <div class="about__content">
          <p class="section-label">Your Guide</p>
          <h2 id="about-title" class="about__title">Hi, I&rsquo;m Jenessa.</h2>
          <p class="about__body">
            I know what it&rsquo;s like to feel stuck &mdash; to love God deeply and still
            wonder when the things He placed in your heart will finally come.{" "}
            <em>[Placeholder &mdash; a short piece of Jenessa&rsquo;s story / testimony to be added here.]</em>
          </p>
          <p class="about__body">
            I created this challenge because I don&rsquo;t believe getting unstuck happens
            through more information. It happens through small, faithful movement with God.
            Over these nine days, I&rsquo;ll walk it with you.
          </p>
          <Button href="#join" label="Join the Challenge" variant="primary" class="about__cta" />
        </div>
      </div>
    </section>

    <!-- 7. ENDORSEMENTS (full-width slider) -->
    <section class="quotes" aria-labelledby="quotes-title">
      <div class="quotes__head container">
        <div>
          <p class="section-label">Endorsements</p>
          <h2 id="quotes-title" class="quotes__title">What others are saying about <span class="quotes__accent">Moving With God</span></h2>
        </div>
        <div class="slider__nav">
          <button class="slider__arrow" type="button" aria-label="Previous endorsement" data-prev>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="slider__arrow" type="button" aria-label="Next endorsement" data-next>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
      <ul class="slider__track" data-track>
        {endorsements.map((c) => (
          <li class={`eqcard eqcard--${c.theme}`}>
            <svg class="eqcard__mark" viewBox="0 0 32 24" aria-hidden="true">
              <path d="M0 24V13.2C0 5.9 4.6 1 12 0l1.4 3.4C9.2 4.6 6.8 7 6.6 10.4H12V24H0Zm18 0V13.2C18 5.9 22.6 1 30 0l1.4 3.4C27.2 4.6 24.8 7 24.6 10.4H30V24H18Z" fill="currentColor" />
            </svg>
            <p class="eqcard__heading">{c.heading}</p>
            <p class="eqcard__body">{c.quote}</p>
            <div class="eqcard__cite">
              <img src={c.img} alt={c.name} width="56" height="56" loading="lazy" />
              <span>
                <span class="eqcard__name">{c.name}</span>
                <span class="eqcard__role">{c.role}</span>
              </span>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- 8. BOOK COMPANION -->
    <section class="book" aria-labelledby="book-title">
      <div class="book__inner container">
        <div class="book__media">
          <img src="/assets/images/challenge-book.jpg" alt="Moving with God book by Jenessa Wait" width="1200" height="1800" loading="lazy" />
        </div>
        <div class="book__content">
          <p class="section-label book__eyebrow">Optional Companion</p>
          <h2 id="book-title" class="book__title">Want to go deeper?<br />Pre-order the book.</h2>
          <p class="book__body">
            The challenge is completely free and stands on its own. If you&rsquo;d like to keep
            going after Day 9, <em>Moving with God</em> expands every theme into nine full
            chapters &mdash; your guide to getting unstuck and stepping boldly into His promises.
          </p>
          <p class="book__meta">Releases October 6 &middot; Pre-order available now</p>
          <Button href="/" label="Explore the Book" variant="primary" class="book__cta" />
        </div>
      </div>
    </section>

    <!-- 9. FAQ -->
    <section class="faq" aria-labelledby="faq-title">
      <div class="faq__inner container">
        <header class="section-head">
          <p class="section-label">Questions</p>
          <h2 id="faq-title">Good things to know</h2>
        </header>
        <div class="faq__list">
          {faqs.map((f, i) => (
            <details class="faq__item" open={i === 0}>
              <summary class="faq__q">
                {f.q}
                <span class="faq__icon" aria-hidden="true"></span>
              </summary>
              <p class="faq__a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 10. FINAL CTA -->
    <section class="final" aria-labelledby="final-title">
      <div class="final__media">
        <img src="/assets/images/challenge-cta.jpg" alt="Jenessa Wait smiling" width="1200" height="1800" loading="lazy" />
      </div>
      <div class="final__panel">
        <div class="final__content">
          <h2 id="final-title" class="final__title">Your next step is closer than it feels.</h2>
          <p class="final__body">
            You don&rsquo;t have to have it all figured out to begin. You just have to take
            the first day. Let&rsquo;s move with God &mdash; together.
          </p>
          <Button href="#join" label="Save My Spot — It's Free" variant="primary" class="final__cta" />
          <p class="final__reassure">Free &middot; Nine short days &middot; Start anytime</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script is:inline>
    (() => {
      const track = document.querySelector("[data-track]");
      if (!track) return;
      const amount = () => Math.min(track.clientWidth * 0.85, 480);
      const prev = document.querySelector("[data-prev]");
      const next = document.querySelector("[data-next]");
      if (prev) prev.addEventListener("click", () => track.scrollBy({ left: -amount(), behavior: "smooth" }));
      if (next) next.addEventListener("click", () => track.scrollBy({ left: amount(), behavior: "smooth" }));
    })();
  </script>
</BaseLayout>

<style>
  /* ---------- Shared section head ---------- */
  .section-head {
    max-width: 40em;
    margin-inline: auto;
    text-align: center;
    margin-bottom: 3em;
  }
  .section-head h2 {
    margin-top: 0.4em;
    color: var(--color-blue);
    font-size: 3.5em;
    line-height: 1;
    letter-spacing: -1.5px;
  }

  /* ---------- 1. Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    background-color: var(--color-blue);
  }
  .hero__panel {
    display: flex;
    align-items: center;
    padding: 5.5em 4em 5.5em var(--container-padding);
  }
  .hero__content { max-width: 27em; color: var(--color-white); }
  .hero__eyebrow { color: var(--color-salmon); }
  .hero__title {
    margin-top: 0.5em;
    color: var(--color-white);
    font-size: 4em;
    line-height: 1;
    letter-spacing: -2px;
  }
  .hero__title-accent { color: var(--color-salmon); }
  .hero__lede {
    margin-top: 0.9em;
    font-size: 1.25em;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.85);
  }
  .hero__form { margin-top: 1.75em; }
  .hero__reassure {
    margin-top: 1.25em;
    font-size: 0.9375em;
    color: rgba(255, 255, 255, 0.7);
  }
  .hero__media { min-height: 100%; position: relative; }
  .hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
  }

  /* ---------- 2. Empathy ---------- */
  .empathy { width: 100%; background-color: var(--color-periwinkle); }
  .empathy__inner { padding-top: 6em; padding-bottom: 3em; }
  .empathy__statement {
    max-width: 14em;
    font-family: var(--font-heading);
    font-weight: 400;
    color: var(--color-blue);
    font-size: 4em;
    line-height: 1.05;
    letter-spacing: -1.5px;
    text-wrap: balance;
  }
  .empathy__statement .u-underline { position: relative; white-space: nowrap; }
  .empathy__statement .hand-underline {
    position: absolute;
    left: 0;
    bottom: 0.04em;
    width: 100%;
    height: auto;
    display: block;
  }
  .empathy__grid {
    margin-top: 3em;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5em;
    align-items: start;
  }
  .empathy__intro {
    font-size: 1.375em;
    line-height: 1.5;
    color: var(--color-text);
  }
  .empathy__close {
    margin-top: 1.25em;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.75em;
    line-height: 1.2;
    letter-spacing: -0.5px;
    color: var(--color-blue);
  }
  .empathy__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.1em;
  }
  .empathy__list li {
    position: relative;
    padding-left: 1.6em;
    font-size: 1.25em;
    line-height: 1.4;
    color: var(--color-text);
  }
  .empathy__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.45em;
    height: 0.45em;
    border-radius: 50%;
    background-color: var(--color-terracotta);
  }

  /* ---------- 3. Steps ---------- */
  .steps { width: 100%; background-color: var(--color-periwinkle); }
  .steps__inner { padding-top: 3em; padding-bottom: 5.5em; }
  .steps__grid {
    list-style: none;
    display: flex;
    align-items: stretch;
    justify-content: center;
  }
  .stepcard {
    position: relative;
    flex: 1 1 0;
    background-color: var(--color-cream);
    padding: 2.75em 2em 3em;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    box-shadow: 0 14px 34px rgba(57, 51, 49, 0.13);
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* gentle stacked rotation + slight overlap (like "Inside Moving with God") */
  .stepcard:not(:first-child) { margin-left: -1.25em; }
  .stepcard:nth-child(1) { transform: rotate(-2deg); z-index: 1; }
  .stepcard:nth-child(2) { transform: rotate(1.5deg); z-index: 3; }
  .stepcard:nth-child(3) { transform: rotate(-1.5deg); z-index: 2; }
  .stepcard:hover { transform: rotate(0deg) scale(1.02); z-index: 4; }
  .steps__cta { margin-top: 4em; text-align: center; }
  .sec-cta { margin-top: 3.5em; text-align: center; }
  .stepcard__num {
    font-family: var(--font-heading);
    color: var(--color-terracotta);
    font-size: 3.5em;
    line-height: 0.8;
  }
  .stepcard__title {
    margin-top: 0.5em;
    font-size: 1.625em;
    line-height: 1.1;
    letter-spacing: -0.5px;
    color: var(--color-dark);
  }
  .stepcard__body {
    margin-top: 0.6em;
    font-size: 1.125em;
    line-height: 1.45;
    color: var(--color-text);
  }

  /* ---------- 4. Receive ---------- */
  .receive { width: 100%; background-color: var(--color-blue); color: var(--color-white); }
  .receive__inner { padding-block: 5.5em; }
  .receive .section-head h2 { color: var(--color-white); }
  .receive .section-label { color: rgba(255, 255, 255, 0.7); }
  .receive__list {
    list-style: none;
    max-width: 44em;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 1.5em;
  }
  .receive__item {
    display: flex;
    gap: 1.1em;
    align-items: flex-start;
    padding-bottom: 1.5em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
  }
  .receive__item:last-child { border-bottom: none; padding-bottom: 0; }
  .receive__check {
    flex: none;
    margin-top: 0.35em;
    width: 0.55em;
    height: 0.95em;
    border: solid var(--color-salmon);
    border-width: 0 0.18em 0.18em 0;
    transform: rotate(45deg);
  }
  .receive__label {
    font-size: 1.375em;
    line-height: 1.15;
    letter-spacing: -0.4px;
    font-family: var(--font-heading);
    font-weight: 400;
  }
  .receive__body {
    margin-top: 0.35em;
    font-size: 1.0625em;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.85);
  }

  /* ---------- 5. Journey (uses the "What's Inside" card palette) ---------- */
  .journey { width: 100%; background-color: var(--color-periwinkle); }
