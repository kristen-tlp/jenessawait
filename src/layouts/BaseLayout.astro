---
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "Moving With God — Jenessa Wait",
  description = "Moving with God by Jenessa Wait — nine keys to getting unstuck and stepping boldly into His promises for your life. Pre-order now (releases October 6) and join the free 9-day challenge.",
  noindex = false,
} = Astro.props;

const canonical = "https://jenessawait.com/";
const siteUrl = "https://jenessawait.com";
const ogImage = `${siteUrl}/assets/images/hero-book.jpg`;

// Structured data (JSON-LD) for SEO / AEO — helps search + AI answer engines
// understand the book, its author, and the pre-order.
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Book",
    name: "Moving with God",
    alternateName: "Moving with God: Nine Keys to Getting Unstuck and Stepping Boldly into His Promises for Your Life",
    author: { "@type": "Person", name: "Jenessa Wait", url: canonical },
    isbn: "9780593602942",
    bookFormat: "https://schema.org/Paperback",
    inLanguage: "en",
    datePublished: "2026-10-06",
    url: canonical,
    image: ogImage,
    description,
    offers: {
      "@type": "Offer",
      availability: "https://schema.org/PreOrder",
      url: "https://a.co/d/0aN1ynB3",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Jenessa Wait",
    jobTitle: "Author",
    url: canonical,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Moving With God — Jenessa Wait",
    url: canonical,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Moving With God" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data (JSON-LD) for SEO / AEO -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Fonts: self-hosted Glamour Absolute (headings) + Sofia Pro (body).
         Sofia Pro Light is loaded from the Adobe Fonts (Typekit) kit. -->
    <link rel="preload" href="/assets/fonts/glamour-absolute.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/hhs5xea.css" />

    <!-- Klaviyo onsite forms loader. Replace YOUR_KLAVIYO_PUBLIC_KEY with your
         Klaviyo Public API Key (Company ID) so the embedded forms render. -->
    <script async type="text/javascript" src="https://static.klaviyo.com/onsite/js/klaviyo.js?company_id=Sjx57P"></script>
  </head>
  <body>
    <a href="#main" class="sr-only">Skip to content</a>
    <slot />

    <!-- Very subtle scroll-linked zoom on photos -->
    <script is:inline>
      (() => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const imgs = Array.from(document.querySelectorAll(".img-zoom img"));
        if (!imgs.length) return;
        let ticking = false;
        const update = () => {
          const vh = window.innerHeight;
          for (const img of imgs) {
            const r = img.getBoundingClientRect();
            if (r.bottom < 0 || r.top > vh) continue;
            const p = 1 - (r.top + r.height / 2) / vh; // 0 at bottom, 1 at top
            const c = Math.max(0, Math.min(1, p));
            img.style.transform = "scale(" + (1 + c * 0.05).toFixed(4) + ")";
          }
          ticking = false;
        };
        const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);
        update();
      })();
    </script>
  </body>
</html>
